{
  "name": "code",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "ssr:build": "ngc -p tsconfig.ssr.json && node scripts/bundle-ssr.mjs",
    "ssr:check": "node scripts/ssr-check.mjs",
    "verify": "npm run build && npm run ssr:build && npm run ssr:check && npm test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "undici": "8.11.2"
  }
}
