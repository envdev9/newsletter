<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ten sam kod, dwa TFM: pokazuje przez refleksje, ktore przeciazenia istnieja na 9 i na 10.
       Uruchom: dotnet run -f net9.0   oraz   dotnet run -f net10.0 (wymaga runtime 9.x i 10.x). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
